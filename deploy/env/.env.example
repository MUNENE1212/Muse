# ============================================
# Muse — Production Environment Template
# ============================================
# Copy to .env on the VPS and fill in real values.
# NEVER commit .env. The .gitignore already excludes it.

# ───────── Core ─────────
NODE_ENV=production
COMPOSE_PROJECT_NAME=muse

# ───────── Domain ─────────
PUBLIC_DOMAIN=muse.example.com
LETSENCRYPT_EMAIL=ops@example.com

# ───────── Postgres ─────────
POSTGRES_DB=muse
POSTGRES_USER=muse
POSTGRES_PASSWORD=change-me-to-a-32-char-random-string
DATABASE_URL=postgres://muse:change-me-to-a-32-char-random-string@postgres:5432/muse

# ───────── Frontend Gateway (Deno Fresh) ─────────
PORT=8000
AI_ENGINE_URL=http://ai-engine:8000
BLOCKCHAIN_URL=http://blockchain-security:3000
SESSION_SECRET=change-me-to-a-64-char-random-string

# ───────── AI Engine (FastAPI) ─────────
AI_ENGINE_PORT=8000
# Optional — if unset the engine runs synthesis-only mode (no LLM enrichment)
GROQ_API_KEY=
# Optional — if unset local TF-IDF/sentiment is used
SPACY_MODEL=en_core_web_sm

# ───────── Blockchain Security (Rust) ─────────
BLOCKCHAIN_PORT=3000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ───────── Observability ─────────
LOG_LEVEL=info
SENTRY_DSN=

# ───────── Backup ─────────
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_CRON=0 3 * * *