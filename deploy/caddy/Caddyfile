# ============================================
# Muse — Caddy reverse proxy + auto-TLS
# ============================================
# Place at deploy/caddy/Caddyfile. Caddy auto-issues Let's Encrypt certs.
# Validate with:  docker run --rm -e PUBLIC_DOMAIN=localhost -v $(pwd)/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro caddy:2.7-alpine caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# ============================================

{$PUBLIC_DOMAIN} {
    encode zstd gzip
    reverse_proxy frontend-gateway:8000

    @ai path /api/ai/*
    handle @ai {
        reverse_proxy ai-engine:8000
    }

    @fresh path /_frsh/*
    handle @fresh {
        reverse_proxy frontend-gateway:8000
    }

    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}