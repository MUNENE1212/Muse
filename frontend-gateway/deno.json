{
  "unstable": ["kv"],
  "lock": true,
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "test": "deno test --allow-all",
    "coverage": "deno test --allow-all --coverage=coverage/",
    "cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "start": "deno run -A --unstable-kv --watch=static/,routes/ dev.ts",
    "build": "deno run -A --unstable-kv dev.ts build",
    "preview": "deno run -A --unstable-kv main.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "qrcode": "npm:qrcode@1.5.3",
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "lucide-preact": "https://esm.sh/lucide-preact@0.469.0?alias=react:preact/compat,react-dom:preact/compat-render&deps=preact@10.22.0",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "tailwindcss/": "npm:/tailwindcss@3.4.1/",
    "tailwindcss/plugin": "npm:/tailwindcss@3.4.1/plugin.js",
    "emoji-picker-element": "https://esm.sh/emoji-picker-element@1.29.1",
    "$std/": "https://deno.land/std@0.216.0/",
    "postgres": "https://deno.land/x/postgres@v0.19.3/mod.ts",
    "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
    "recharts": "https://esm.sh/recharts@2.12.0?alias=react:preact/compat,react-dom:preact/compat&deps=preact@10.22.0"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "nodeModulesDir": "auto"
}
