# ============================================
# Muse — Environment Variables Example
# ============================================
# Copy this file to .env and fill in real values
# cp .env.example .env
# ============================================

# Application
NODE_ENV=production
COMPOSE_PROJECT_NAME=muse
PUBLIC_DOMAIN=muse.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Database (PostgreSQL)
POSTGRES_DB=muse
POSTGRES_USER=muse
POSTGRES_PASSWORD=<GENERATE_SECURE_32_CHAR_PASSWORD>
DATABASE_URL=postgres://muse:<PASSWORD>@postgres:5432/muse

# Frontend Gateway
PORT=8000
AI_ENGINE_URL=http://ai-engine:8000
BLOCKCHAIN_URL=http://blockchain-security:3000
SESSION_SECRET=<GENERATE_SECURE_64_CHAR_SECRET>

# AI Engine (Phase 2: Replace with GLM/Zhipu AI)
# For MVP: ZHIPU_API_KEY (GLM models)
ZHIPU_API_KEY=<from platform.zhipuai.cn>
GLM_MODEL=glm-4
# Legacy: Groq (being replaced)
GROQ_API_KEY=placeholder-not-set

# AI Engine Config
AI_ENGINE_PORT=8000
LOG_LEVEL=info

# Blockchain Security (Optional for MVP)
BLOCKCHAIN_PORT=3000
SOLANA_RPC_URL=https://api.devnet.solana.com

# Backups (Phase 5)
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ============================================
# CI/CD — required for `.github/workflows/deploy.yml`
# ============================================
# The deploy workflow expects these to be set either as
#   - repo variables (default for non-secret values), or
#   - repo secrets (use for the SSH key).
# Default values shown below match the production VPS.
VPS_HOST=69.164.244.165
VPS_USER=root
VPS_PORT=22
# VPS_SSH_KEY (secret) — the *private* key of
#   /opt/muse/.ssh/id_ed25519 on the VPS. The corresponding public key
#   is already in /opt/muse/.ssh/authorized_keys.
